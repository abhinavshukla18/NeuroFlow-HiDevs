# ---------- Database (Postgres + pgvector) ----------
# Database name (default: neuroflow)
POSTGRES_DB=neuroflow
# Database user (default: neuroflow)
POSTGRES_USER=neuroflow
# Required: strong random password
POSTGRES_PASSWORD=
# Required in cloud: private hostname of the Postgres service (default: postgres)
POSTGRES_HOST=postgres
# Port (default: 5432)
POSTGRES_PORT=5432
# Optional: asyncpg pool sizes
DB_POOL_MIN_SIZE=
DB_POOL_MAX_SIZE=

# ---------- Redis ----------
# Required: strong random password
REDIS_PASSWORD=
# Required in cloud: Redis hostname (default: redis)
REDIS_HOST=redis
# Port (default: 6379)
REDIS_PORT=6379

# ---------- LLM providers ----------
# Optional: empty disables OpenAI models (a built-in fake provider is used)
OPENAI_API_KEY=
# Optional: empty disables Claude models
ANTHROPIC_API_KEY=
# Set to true ONLY when no OPENAI_API_KEY is set, so retrieval still works with fake embeddings
FAKE_EMBEDDINGS=

# ---------- MLflow ----------
# Required: base URL of the MLflow server (default: http://mlflow:5000)
MLFLOW_TRACKING_URI=http://mlflow:5000
# Required on the mlflow service: comma-separated hostnames it accepts
MLFLOW_SERVER_ALLOWED_HOSTS=mlflow:5000,mlflow,localhost:5000

# ---------- Security ----------
# Required: random signing key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
# Required: admin client (scopes: query, ingest, admin)
ADMIN_CLIENT_ID=admin-client
ADMIN_CLIENT_SECRET=
# Required: query-only client (scope: query)
QUERY_CLIENT_ID=query-client
QUERY_CLIENT_SECRET=
# Required in cloud: comma-separated frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000
# Set to 1 ONLY for load tests (disables per-IP rate limits)
DISABLE_RATE_LIMIT=

# ---------- Telemetry ----------
# Optional: OTLP collector endpoint (default: jaeger:4317 in docker compose)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------- Frontend (build-time) ----------
# Required for the frontend build: public URL of the API
NEXT_PUBLIC_API_URL=http://localhost:8000